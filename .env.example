# .env.example - 复制成 .env 后填入真实 Key（.env 不要提交 Git）
DASHSCOPE_API_KEY=sk-你的通义千问Key
AMAP_API_KEY=你的高德Key
LOG_LEVEL=INFO

# ===== API 服务配置 =====
# CORS 白名单（逗号分隔；填 * 表示放行所有来源，仅限内网/开发）
API_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# 可选鉴权：留空则 /chat 等接口无需密钥；填了之后请求必须带 X-API-Key 头
API_KEY=
# 每 IP 每分钟请求数上限（0 表示关闭限流）
API_RATE_LIMIT_PER_MINUTE=30
